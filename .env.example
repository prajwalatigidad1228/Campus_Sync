# ──────────────────────────────────────────────────────────────
#  Campus_Sync  –  Environment Variables Template
#  Copy this file to .env and fill in your values:
#     cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── Flask ──────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Long random secret – CHANGE THIS before production!
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ───────────────────────────────────────────────────
# PostgreSQL (production). Leave blank to fall back to SQLite.
DATABASE_URL=postgresql://username:password@localhost:5432/campus_sync_db

# SQLite filename used when DATABASE_URL is not set
SQLITE_DB_PATH=campus_sync.db

# ── AI / Copilot (future phase) ────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── File Uploads ───────────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=16

# ── Mail (future phase) ────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
